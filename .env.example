# SchoolSync Operating Mode: 'demo' or 'production'
# In 'demo' mode, mock data, simulated GPS and local storage are used without requiring Firebase or Google Maps keys.
VITE_APP_MODE=demo

# Firebase Production Configuration (Required when VITE_APP_MODE=production)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Google Maps Platform API Key (Used in production for live routing and Google Maps tiles)
VITE_GOOGLE_MAPS_API_KEY=

# Optional Gemini API key if smart notifications or OCR assistance is enabled
GEMINI_API_KEY=
APP_URL=
